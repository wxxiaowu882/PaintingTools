079,0.069],"localNormal":[0.612,-0.191,0.767],"baseDist":6.098455309977509,"baseScale":5.8,"labelShape":"circle"},{"id":"anno_1789601593943_226","annotationKind":"leader","text":"E","detailText":"","collapsed":false,"color":"#cccccc","dx":-65.38467009365775,"dy":18.106414381549023,"dxN":-0.037835,"dyN":0.017647,"dxW":-0.174313,"dyW":0.048271,"localPos":[0.0209,0.0529,0.0156],"localNormal":[0.704,-0.464,0.537],"baseDist":5.84204115997811,"baseScale":5.8,"labelShape":"circle"}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"view","slot":"V05a","status":"handtuned","detail":"侧后（见鼻）外轮廓的重要点位；请与「隐鼻」对照","keyPoints":"本场景的研究对象是侧后（见鼻）视角的头部外轮廓。请与「隐鼻」对照：角度再偏后一点，鼻就会从外轮廓上消失。如果您不小心转动了视角，请点击重置按钮恢复视角。\n\n请看场景中的标注，1–5 是轮廓上的凸起，A–E 是外轮廓上的重要凹陷。这些点位决定了侧后（见鼻）视角下头部的外轮廓形态特征。（耳朵在所有场景都不参与外轮廓的标注）\n\n实际中每个人凹凸强弱不同，创作时先有这些点位的框架，再按个体强化、弱化这些点位的偏移，即可得到不同的人物特征。\n\n各点位名称如下：\n1.额结节\n2.眉弓\n3.鼻头\n（颧凸隆常被鼻头遮挡）\n4.口轮匝肌/上下唇\n  如果口轮匝肌较厚，则上下唇被右侧口轮匝肌遮挡；\n  如果口轮匝肌较薄，则露出上下唇\n5.颏结节\nA.眉弓上缘\nB.眼裂\nC.颊凹（颧骨下方）\nD.口轮匝肌下缘／颏唇沟同一水平线上\nE.颈点","keyPointsRich":"本场景的研究对象是侧后（见鼻）视角的头部外轮廓。请与「隐鼻」对照：角度再偏后一点，鼻就会从外轮廓上消失。如果您不小心转动了视角，请点击重置按钮恢复视角。<br><br>请看场景中的标注，1–5 是轮廓上的凸起，A–E 是外轮廓上的重要凹陷。这些点位决定了侧后（见鼻）视角下头部的外轮廓形态特征。（耳朵在所有场景都不参与外轮廓的标注）<br><br>实际中每个人凹凸强弱不同，创作时先有这些点位的框架，再按个体强化、弱化这些点位的偏移，即可得到不同的人物特征。<br><br><br>各点位名称如下：<br>1.额结节<br>2.眉弓<br>3.鼻头<br>（颧凸隆常被鼻头遮挡）<br>4.口轮匝肌/上下唇<br>  如果口轮匝肌较厚，则上下唇被右侧口轮匝肌遮挡；<br>  如果口轮匝肌较薄，则露出上下唇<br>5.颏结节<br>A.眉弓上缘<br>B.眼裂<br>C.颊凹（颧骨下方）<br>D.口轮匝肌下缘／颏唇沟同一水平线上<br>E.颈点"},"id":"V05a"}
