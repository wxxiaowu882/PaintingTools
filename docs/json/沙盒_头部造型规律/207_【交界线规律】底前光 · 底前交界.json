0.0044,-0.0004,-0.0019]}],"kind":"bezier","strokeWidth":2,"capR":1},{"id":"dash_line_1789689178858","color":"#bfbfbf","points":[{"pos":[0.0493,0.1458,0.0558],"norm":[0.583,0.105,0.806],"handleOut":[-0.0064,-0.0026,0.004]},{"pos":[0.0336,0.144,0.0638],"norm":[0.271,0.06,0.961],"handleIn":[0.0052,-0.0004,-0.0027]}],"kind":"bezier","strokeWidth":2,"capR":1}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"light","slot":"L07","status":"handtuned","detail":"底前光下正脸明暗交界（内轮廓）关键线段","keyPoints":"本场景的研究对象是底前光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。\n\n请看场景中的标注，短曲线勾在看得见的明暗交界上，圆标只作各段编号。②⑦⑧左右各一段。这些交界线段决定了这一档光下头部的光影交界形态。\n\n实际中每个人结构起伏强弱不同，创作时先有这些交界的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。\n\n各段交界名称如下：\n①.眉弓\n②.颧骨上的交界+颧骨到鼻唇沟的交界\n③.鼻底的交界\n④.上唇白脊上方以及嘴角肌肉上的交界\n⑤.下唇白脊交界\n⑥.下巴前缘／颏凸隆上的交界\n⑦.鼻唇沟\n⑧.侧方脸颊转向下颌底的交界\n    此处下颌底和侧脸虽是大面的转折，但过渡柔和渐缓，交界线不明显。不过如果旋转模型对比下颌底和侧脸的亮度，还是能发现较明显的亮度差异。另外，下颌骨宽大者要稍明显。\n\n可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。","keyPointsRich":"本场景的研究对象是底前光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。<br><br>请看场景中的标注，短曲线勾在看得见的明暗交界上，圆标只作各段编号。②⑦⑧左右各一段。这些交界线段决定了这一档光下头部的光影交界形态。<br><br>实际中每个人结构起伏强弱不同，创作时先有这些交界的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。<br><br>各段交界名称如下：<br>①.眉弓<br>②.颧骨上的交界+颧骨到鼻唇沟的交界<br>③.鼻底的交界<br>④.上唇白脊上方以及嘴角肌肉上的交界<br>⑤.下唇白脊交界<br>⑥.下巴前缘／颏凸隆上的交界<br>⑦.鼻唇沟<br>⑧.侧方脸颊转向下颌底的交界<br>    此处下颌底和侧脸虽是大面的转折，但过渡柔和渐缓，交界线不明显。不过如果旋转模型对比下颌底和侧脸的亮度，还是能发现较明显的亮度差异。另外，下颌骨宽大者要稍明显。<br><br>可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。"},"id":"L07"}