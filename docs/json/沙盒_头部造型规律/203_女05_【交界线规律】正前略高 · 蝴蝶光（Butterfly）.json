0.738,-0.043,0.673],"handleIn":[-0.0144,-0.0075,0.0029]}],"kind":"bezier","strokeWidth":2,"capR":1},{"id":"dash_line_1789633571000","color":"#bfbfbf","points":[{"pos":[-0.0425,0.2,0.062],"norm":[-0.799,0.062,0.598],"handleOut":[0.0061,-0.0033,0.0046]},{"pos":[-0.0236,0.1979,0.069],"norm":[0.177,-0.129,0.976],"handleIn":[-0.0081,-0.0017,-0.0006]}],"kind":"bezier","strokeWidth":2,"capR":1}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"light","slot":"L03","status":"screen_remap_handtune_ready","detail":"正前略高光下的明暗交界（内轮廓）关键线段","keyPoints":"本场景的研究对象是正前略高光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。\n\n请看场景中的标注，短曲线勾在看得见的明暗交界上，圆标只作各段编号。这些交界线段决定了这一档光下头部的光影交界形态。\n\n实际中每个人结构起伏强弱不同，创作时先有这些交界的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。\n\n各段交界名称如下：\n①.眉弓（眶外角 → 眉峰 → 眉头 → 鼻根一侧）\n②.下眼睑\n③.鼻底／侧交界（蝶影的关键边缘）\n④.上唇上缘与嘴角上缘\n⑤.颏唇沟区域上缘\n⑥.下巴下缘偏上一圈\n⑦.颧骨到颏唇沟的交界\n⑧.脸颊上（颊凹下缘）\n⑦和⑧之间的凹陷是颊凹\n\n可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。\n\n本场景是同一课的对比个体（女05）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。\n\n","keyPointsRich":"本场景的研究对象是正前略高光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。<br><br>请看场景中的标注，短曲线勾在看得见的明暗交界上，圆标只作各段编号。这些交界线段决定了这一档光下头部的光影交界形态。<br><br>实际中每个人结构起伏强弱不同，创作时先有这些交界的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。<br><br>各段交界名称如下：<br><strong>①.眉弓（眶外角 → 眉峰 → 眉头 → 鼻根一侧）</strong><br><strong>②.下眼睑</strong><br><strong>③.鼻底／侧交界（蝶影的关键边缘）</strong><br><strong>④.上唇上缘与嘴角上缘</strong><br><strong>⑤.颏唇沟区域上缘</strong><br><strong>⑥.下巴下缘偏上一圈</strong><br><strong>⑦.颧骨到颏唇沟的交界</strong><br><strong>⑧.脸颊上（颊凹下缘）</strong><br><strong><br></strong><br><strong>⑦和⑧之间的凹陷是颊凹<br></strong><br>可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。<br><br>本场景是同一课的对比个体（女05）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。"},"id":"L03_female_05"}
