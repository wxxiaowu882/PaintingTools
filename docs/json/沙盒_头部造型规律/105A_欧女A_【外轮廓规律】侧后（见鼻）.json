.134662,"dyW":-0.002256,"localPos":[0.031,0.1088,0.0666],"localNormal":[0.669,-0.3,0.68],"baseDist":5.9067,"baseScale":5.7705,"labelShape":"circle"},{"id":"anno_1789601593943_226","annotationKind":"leader","text":"E","detailText":"","collapsed":false,"color":"#cccccc","dx":-45.5274448142316,"dy":52.98464151514785,"dxN":-0.023488,"dyN":0.046102,"dxW":-0.101938,"dyW":0.118635,"localPos":[0.0241,0.0851,0.0227],"localNormal":[0.36,-0.895,0.263],"baseDist":6.0428,"baseScale":5.7705,"labelShape":"circle"}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"view","slot":"V05a","status":"vision_place_pending_qa","detail":"侧后（见鼻）外轮廓的重要点位；请与「隐鼻」对照","keyPoints":"本场景的研究对象是侧后（见鼻）视角的头部外轮廓。请与「隐鼻」对照：角度再偏后一点，鼻就会从外轮廓上消失。如果您不小心转动了视角，请点击重置按钮恢复视角。\n\n请看场景中的标注，1–5 是轮廓上的凸起，A–E 是外轮廓上的重要凹陷。这些点位决定了侧后（见鼻）视角下头部的外轮廓形态特征。（耳朵在所有场景都不参与外轮廓的标注）\n\n实际中每个人凹凸强弱不同，创作时先有这些点位的框架，再按个体强化、弱化这些点位的偏移，即可得到不同的人物特征。\n\n各点位名称如下：\n1.额结节\n2.眉弓\n3.鼻头\n（颧凸隆常被鼻头遮挡）\n4.口轮匝肌/上下唇\n  如果口轮匝肌较厚，则上下唇被右侧口轮匝肌遮挡；\n  如果口轮匝肌较薄，则露出上下唇\n5.颏结节\nA.眉弓上缘\nB.眼裂/眼球\nC.颊凹（颧骨下方）\n   此例因口轮匝肌不发达（不突出），所以没有看到由口轮匝肌和颧凸围成的明显凹陷（颊凹），但是仍标注该点位。\nD.降口角肌\nE.颈点","keyPointsRich":"本场景的研究对象是侧后（见鼻）视角的头部外轮廓。请与「隐鼻」对照：角度再偏后一点，鼻就会从外轮廓上消失。如果您不小心转动了视角，请点击重置按钮恢复视角。<br><br>请看场景中的标注，1–5 是轮廓上的凸起，A–E 是外轮廓上的重要凹陷。这些点位决定了侧后（见鼻）视角下头部的外轮廓形态特征。（耳朵在所有场景都不参与外轮廓的标注）<br><br>实际中每个人凹凸强弱不同，创作时先有这些点位的框架，再按个体强化、弱化这些点位的偏移，即可得到不同的人物特征。<br><br>各点位名称如下：<br>1.额结节<br>2.眉弓<br>3.鼻头<br>（颧凸隆常被鼻头遮挡）<br>4.口轮匝肌/上下唇<br>  如果口轮匝肌较厚，则上下唇被右侧口轮匝肌遮挡；<br>  如果口轮匝肌较薄，则露出上下唇<br>5.颏结节<br>A.眉弓上缘<br>B.眼裂/眼球<br>C.颊凹（颧骨下方）<br>   此例因口轮匝肌不发达（不突出），所以没有看到由口轮匝肌和颧凸围成的明显凹陷（颊凹），但是仍标注该点位。<br>D.降口角肌<br>E.颈点","modelLabel":"欧女A","modelId":"female_euro_02"},"id":"V05a_female_euro_02"}