.2317,0.0302],"norm":[-0.781,0.278,0.559],"handleOut":[0,0,0]},{"pos":[-0.0439,0.2088,0.06],"norm":[-0.597,0.685,0.417],"handleIn":[0,0,0],"handleOut":[0,0,0]},{"pos":[-0.0573,0.1883,0.0461],"norm":[-0.85,-0.005,0.527],"handleIn":[0,0,0]}],"kind":"bezier"},{"id":"dash_line_1789996060240","color":"#c2c2c2","points":[{"pos":[-0.0007,0.2955,-0.0348],"norm":[0.037,0.984,-0.173],"handleOut":[0,0,0]},{"pos":[-0.0659,0.2624,-0.0474],"norm":[-0.704,0.71,-0.024],"handleIn":[0.0182,0.0156,0.0016],"handleOut":[-0.0223,-0.0191,-0.002]},{"pos":[-0.0811,0.2266,-0.051],"norm":[-0.947,0.112,-0.301],"handleIn":[0,0,0],"handleOut":[0,0,0]},{"pos":[-0.0653,0.1708,0.0367],"norm":[-0.946,0.09,0.312],"handleIn":[-0.0084,0.0192,-0.03],"handleOut":[0.0007,-0.0017,0.0026]},{"pos":[-0.0581,0.1613,0.0541],"norm":[-0.922,-0.014,0.388],"handleIn":[0,0,0],"handleOut":[0,0,0]},{"pos":[-0.0674,0.1183,0.0128],"norm":[-0.844,-0.517,0.144],"handleIn":[0,0,0]}],"kind":"bezier","occludeDot":-0.35},{"id":"dash_line_1789998091502","color":"#c2c2c2","points":[{"pos":[-0.0652,0.1699,0.0375],"norm":[-0.93,0.038,0.365],"handleOut":[-0.0001,-0.0161,-0.0079]},{"pos":[-0.0674,0.1183,0.0128],"norm":[-0.844,-0.517,0.144],"handleIn":[0,0,0],"handleOut":[0,0,0]},{"pos":[-0.027,0.0791,0.0641],"norm":[-0.844,-0.343,0.413],"handleIn":[0,0,0],"handleOut":[0,0,0]},{"pos":[-0.0043,0.0722,0.0691],"norm":[-0.144,-0.964,0.224],"handleIn":[0,0.0006,0.0003]}],"kind":"bezier"}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"light","slot":"L05","status":"seed_contrast","detail":"正前光下头侧明暗交界（内轮廓）关键点位","keyPoints":"本场景的研究对象是正前光下的头侧明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。\n\n请看场景中的标注，圆标钉在交界经过的关键结构点上。这些点位决定了这一档光下头部的光影交界形态。\n\n实际中每个人结构起伏强弱不同，创作时先有这些点位的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。\n\n各点位／交界名称如下：\n\n【交界1 · 头侧主线】\n①.颅顶点（颅盖正中最高点；发下头骨转折）\n②.脑颅侧方最宽点\n高度约耳到头顶一半。头前后较长时多在耳廓后上方，常即顶结节；头前后较短或后脑偏平时可能移到耳尖正上方，,甚至耳廓前上方。\n③.颧骨弓隆起\n④.颧突隆\n⑤.颊转角（咬肌下半部最鼓出的点位）\n⑥.颏结节\n⑦.颏底\n\n注意③④⑤这个三角形：我称之为\"颧咬三角灰面\"，③→⑤是三边中最深的主交界，其它两边是略淡的副交界，他们围成了这个渐变的灰面。\n\n【交界2 · 颞—眉—眼】\nA→B.颞线（B是眉峰）\nC.眶外角\n正前光下，这条交界依赖颞线、眉峰、眶外角一带的前后转折。此转折欧美人种较明显，但是头型偏扁、东亚人种、女性、低龄者，此转折一般过渡平缓而交界明暗对比不明显。但是不管怎样，点位框架仍用A→B→C，再按个体强弱调整。\n\n可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。\n\n本场景是同一课的对比个体（叶问）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。","keyPointsRich":"本场景的研究对象是正前光下的头侧明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。<br><br>请看场景中的标注，圆标钉在交界经过的关键结构点上。这些点位决定了这一档光下头部的光影交界形态。<br><br>实际中每个人结构起伏强弱不同，创作时先有这些点位的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。<br><br>各点位／交界名称如下：<br><br><strong>【交界1 · 头侧主线】</strong><br><strong>①.颅顶点（颅盖正中最高点；发下头骨转折）</strong><br><strong>②.脑颅侧方最宽点</strong><br><strong>高度约耳到头顶一半。头前后较长时多在耳廓后上方，常即顶结节；头前后较短或后脑偏平时可能移到耳尖正上方，,甚至耳廓前上方。</strong><br><strong>③.颧骨弓隆起</strong><br><strong>④.颧突隆</strong><br><strong>⑤.颊转角（咬肌下半部最鼓出的点位）</strong><br><strong>⑥.颏结节</strong><br><strong>⑦.颏底</strong><br><strong><br></strong><br><strong>注意③④⑤这个三角形：我称之为\"颧咬三角灰面\"，③→⑤是三边中最深的主交界，其它两边是略淡的副交界，他们围成了这个渐变的灰面。</strong><br><strong><br></strong><br><strong>【交界2 · 颞—眉—眼】</strong><br><strong>A→B.颞线（B是眉峰）</strong><br><strong>C.眶外角</strong><br><strong>正前光下，这条交界依赖颞线、眉峰、眶外角一带的前后转折。此转折欧美人种较明显，但是头型偏扁、东亚人种、女性、低龄者，此转折一般过渡平缓而交界明暗对比不明显。但是不管怎样，点位框架仍用A→B→C，再按个体强弱调整。<br></strong><br>可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。<br><br>本场景是同一课的对比个体（叶问）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。"},"id":"L05_male_ipman_01"}