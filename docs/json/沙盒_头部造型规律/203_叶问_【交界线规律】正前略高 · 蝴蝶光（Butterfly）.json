,-0.0013,0.0049]},{"pos":[-0.0203,0.1809,0.0651],"norm":[0.477,0.088,0.874],"handleIn":[-0.0106,-0.0017,0.0019]}],"kind":"bezier","strokeWidth":2,"capR":1},{"id":"dash_line_1789994089248","color":"#cfcfcf","points":[{"pos":[0.0172,0.1789,0.0651],"norm":[-0.488,0.177,0.855],"handleOut":[0.0154,-0.0018,0.0026]},{"pos":[0.0401,0.1803,0.062],"norm":[0.745,0.356,0.564],"handleIn":[0,0,0]}],"kind":"bezier","strokeWidth":2,"capR":1}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"light","slot":"L03","status":"seed_contrast","detail":"正前略高光下的明暗交界（内轮廓）关键线段","keyPoints":"本场景的研究对象是正前略高光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。\n\n请看场景中的标注，短曲线勾在看得见的明暗交界上，圆标只作各段编号。这些交界线段决定了这一档光下头部的光影交界形态。\n\n实际中每个人结构起伏强弱不同，创作时先有这些交界的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。\n\n各段交界名称如下：\n①.眉弓（眶外角 → 眉峰 → 眉头 → 鼻根一侧）\n②.下眼睑（此模特卧蚕不明显，所以下眼睑上的交界几何没有，但是这里仍然做个标记）\n③.鼻底／侧交界（蝶影的关键边缘）\n④.上唇上缘与嘴角上缘\n⑤.颏唇沟上缘\n（如图降下唇肌发达的情况，在降下唇肌侧面也会有交界）\n⑥.下巴下缘偏上一圈\n⑦.颧骨上\n⑧.脸颊上\n（颊凹下方凸起区域的交界线，和嘴角两侧轮匝肌的交界线连起来）\n\n可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。\n\n本场景是同一课的对比个体（叶问）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。\n","keyPointsRich":"本场景的研究对象是正前略高光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。<br><br>请看场景中的标注，短曲线勾在看得见的明暗交界上，圆标只作各段编号。这些交界线段决定了这一档光下头部的光影交界形态。<br><br>实际中每个人结构起伏强弱不同，创作时先有这些交界的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。<br><br>各段交界名称如下：<br><strong>①.眉弓（眶外角 → 眉峰 → 眉头 → 鼻根一侧）</strong><br><strong>②.下眼睑</strong><br><strong>（此模特卧蚕不明显，所以下眼睑上的交界几何没有，但是这里仍然做个标记）<br></strong><strong>③.鼻底／侧交界（蝶影的关键边缘）</strong><br><strong>④.上唇上缘与嘴角上缘</strong><br><strong>⑤.颏唇沟上缘</strong><br><strong>（如图降下唇肌发达的情况，在降下唇肌侧面也会有交界）<br></strong><strong>⑥.下巴下缘偏上一圈</strong><br><strong>⑦.颧骨上</strong><br><strong>⑧.脸颊上</strong><br><strong>（颊凹下方凸起区域的交界线，和嘴角两侧轮匝肌的交界线连起来）<br></strong><br>可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。<br><br>本场景是同一课的对比个体（叶问）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。"},"id":"L03_male_ipman_01"}