0.0142],"norm":[-0.992,-0.022,0.122],"handleOut":[0.0028,-0.0138,0.0017]},{"pos":[-0.0547,0.1387,0.0234],"norm":[-0.861,-0.482,0.166],"handleIn":[-0.0028,0.0138,-0.0017]}],"kind":"bezier","capR":1},{"id":"dash_line_1789642255102","color":"#989a37","points":[{"pos":[-0.0158,0.2971,-0.0069],"norm":[-0.29,0.955,0.064],"handleOut":[-0.0077,-0.0072,0.003]},{"pos":[-0.065,0.2451,-0.0003],"norm":[-0.97,0.241,0.026],"handleIn":[0.0005,0.0032,-0.0015],"handleOut":[-0.0001,-0.0011,0.0008]},{"pos":[-0.0693,0.2149,-0.0039],"norm":[-0.999,0.004,0.054],"handleIn":[0,-0.0001,0.0001]}],"kind":"bezier","capR":1,"lineStyle":"dotted"},{"id":"dash_line_1789643949532","color":"#cfcfcf","points":[{"pos":[-0.0555,0.2042,0.0473],"norm":[-0.881,0.056,0.47],"handleOut":[-0.0006,-0.0014,-0.0007]},{"pos":[-0.0461,0.227,0.0602],"norm":[-0.684,0.411,0.603],"handleIn":[-0.0003,-0.0021,0.0008],"handleOut":[-0.0007,-0.0007,-0.0003]},{"pos":[-0.0542,0.2521,0.0375],"norm":[-0.844,0.313,0.436],"handleIn":[0.003,-0.0103,0.0099]}],"kind":"bezier","strokeWidth":2.5,"capR":1.5}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"light","slot":"L05","status":"screen_remap_handtune_ready","detail":"正前光下头侧明暗交界（内轮廓）关键点位","keyPoints":"本场景的研究对象是正前光下的头侧明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。\n\n请看场景中的标注，圆标钉在交界经过的关键结构点上。这些点位决定了这一档光下头部的光影交界形态。\n\n实际中每个人结构起伏强弱不同，创作时先有这些点位的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。\n\n各点位／交界名称如下：\n\n【交界1 · 头侧主线】\n①.颅顶点（颅盖正中最高点；发下头骨转折）\n②.脑颅侧方最宽点\n高度约耳到头顶一半。头前后较长时多在耳廓后上方（红②处），常即顶结节；头前后较短或后脑偏平时可能移到耳尖正上方,甚至耳廓前上方。本模在耳阔前\n上方一带（黄②处）。\n\n③.颧骨弓隆起\n④.颧突隆\n⑤.颊转角（咬肌下半部最鼓出的点位）\n⑥.颏结节\n⑦.颏底\n\n注意③④⑤这个三角形：我称之为\"颧咬三角灰面\"，③→⑤是三边中最深的主交界，其它两边是略淡的副交界，他们围成了这个渐变的灰面。\n\n【交界2 · 颞—眉—眼】\nA→B.颞线（B是眉峰）\nC.眶外角\n正前光下，这条交界依赖颞线、眉峰、眶外角一带的前后转折。此转折欧美人种较明显，但是头型偏扁、东亚人种、女性、低龄者，此转折一般过渡平缓而交界明暗对比不明显。但是不管怎样，点位框架仍用A→B→C，再按个体强弱调整。\n\n可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。\n\n本场景是同一课的对比个体（女05）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。","keyPointsRich":"本场景的研究对象是正前光下的头侧明暗交界线（也可叫内轮廓）。请不要改