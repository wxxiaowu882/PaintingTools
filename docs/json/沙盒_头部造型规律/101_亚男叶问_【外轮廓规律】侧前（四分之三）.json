0655],"localNormal":[-0.654,-0.149,0.742],"baseDist":6.6784,"baseScale":5.8,"labelShape":"circle"},{"id":"anno_1789977888773_93","annotationKind":"leader","text":"6","detailText":"","collapsed":false,"color":"#00e8e8","dx":-121.72472333960869,"dy":40.61991230716662,"dxN":-0.0703,"dyN":0.039511,"dxW":-0.311043,"dyW":0.103796,"localPos":[-0.0073,0.0749,0.0748],"localNormal":[0.013,-0.857,0.515],"baseDist":6.414189668946783,"baseScale":5.8,"labelShape":"circle"}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"view","slot":"V01","status":"vision_place_pending_qa","detail":"侧前外轮廓的重要点位，通过点位抓外轮廓形态规律","keyPoints":"本场景的研究对象是侧前（四分之三）视角的头部外轮廓。如果您不小心转动了视角，请点击重置按钮恢复视角。\n\n请看场景中的标注，1、2、3、4、5、6  是轮廓上的5个凸起，A、B、C、D 是外轮廓上的4个凹陷。这些点位决定了侧前视角下头部的外轮廓形态特征。（耳朵在所有场景都不参与外轮廓的标注）\n\n实际中每个人凹凸强弱不同，创作时先有这些点位的框架，再按个体强化、弱化这些点位的偏移，即可得到不同的人物特征。\n\n各点位名称如下：\n①.额结节\n②.眉弓\n③.颧突隆\n④.口角轴\n⑤.颏肌/颏肌一侧\n  亚洲人头部中线向两边后收慢，⑤点很可能落在颏肌一侧的下巴上，而欧美人头部中线向两边后收快，⑤点很可能落在颏肌上\n⑥.颏底\n\nA.眉弓上缘\nB.外眼角后收处\nC.颊凹\nD.降口角肌","keyPointsRich":"本场景的研究对象是侧前（四分之三）视角的头部外轮廓。如果您不小心转动了视角，请点击重置按钮恢复视角。<br><br>请看场景中的标注，1、2、3、4、5、6  是轮廓上的5个凸起，A、B、C、D 是外轮廓上的4个凹陷。这些点位决定了侧前视角下头部的外轮廓形态特征。（耳朵在所有场景都不参与外轮廓的标注）<br><br>实际中每个人凹凸强弱不同，创作时先有这些点位的框架，再按个体强化、弱化这些点位的偏移，即可得到不同的人物特征。<br><br>各点位名称如下：<br><strong>①.额结节</strong><br><strong>②.眉弓</strong><br><strong>③.颧突隆</strong><br><strong>④.口角轴</strong><br><strong>⑤.颏肌/颏肌一侧</strong><br><strong>  亚洲人头部中线向两边后收慢，⑤点很可能落在颏肌一侧的下巴上，而欧美人头部中线向两边后收快，⑤点很可能落在颏肌上</strong><br><strong>⑥.颏底</strong><br><strong><br></strong><strong>A.眉弓上缘</strong><br><strong>B.外眼角后收处</strong><br><strong>C.颊凹</strong><br><strong>D.降口角肌</strong><br><strong><br></strong>","modelLabel":"亚男叶问","modelId":"male_ipman_01"},"id":"V01_male_ipman_01"}