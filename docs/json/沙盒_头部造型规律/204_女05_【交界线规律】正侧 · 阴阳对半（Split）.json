4,0.0735],"norm":[-0.138,0.156,0.978],"handleOut":[-0.0017,-0.0055,-0.0021]},{"pos":[-0.0097,0.112,0.0672],"norm":[-0.312,-0.797,0.517],"handleIn":[0.0017,0.0055,0.0021]}],"kind":"bezier","strokeWidth":2,"capR":1},{"id":"dash_line_1789635968446","color":"#bfbfbf","points":[{"pos":[-0.0324,0.1792,0.0699],"norm":[-0.238,0.068,0.969],"handleOut":[0.0009,-0.0075,-0.0002]},{"pos":[-0.0311,0.1603,0.069],"norm":[-0.374,-0.134,0.918],"handleIn":[-0.0009,0.0075,0.0002]}],"kind":"bezier","strokeWidth":2,"capR":1}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"light","slot":"L04","status":"screen_remap_handtune_ready","detail":"正侧光下的明暗交界（内轮廓）关键点位","keyPoints":"本场景的研究对象是正侧光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。\n\n请看场景中的标注，圆标钉在交界经过的关键结构点上。这些点位决定了这一档光下头部的光影交界形态。\n\n实际中每个人结构起伏强弱不同，创作时先有这些点位的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。\n\n各点位／交界名称如下：\n\n【交界1 · 额—眉—睑】\n⓪.颅顶结节\n①.发际线\n②.额结节\n③.眉弓凸起\n④.眉峰\n⑤.下眼睑（睑颊沟）\n\n【交界2 · 鼻—口—颏】\n⑥.鼻根一侧\n⑦.鼻底\n⑧.唇峰\n⑨.嘴角窝\n⑩→⑪.下唇一侧圆形凸起，到降下唇肌上的交界\n⑫→⑬.颏肌上的交界\n\n【交界3 · 颧→鼻唇沟】（对照）\nⒶ→Ⓑ.颧骨到鼻唇沟附近\n本模上这条交界很明显（东方人前脸较平）\n\n可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。\n\n本场景是同一课的对比个体（女05）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。","keyPointsRich":"本场景的研究对象是正侧光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。<br><br>请看场景中的标注，圆标钉在交界经过的关键结构点上。这些点位决定了这一档光下头部的光影交界形态。<br><br>实际中每个人结构起伏强弱不同，创作时先有这些点位的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。<br><br>各点位／交界名称如下：<br><br><strong>【交界1 · 额—眉—睑】</strong><br><strong>⓪.颅顶结节<br></strong><strong>①.发际线</strong><br><strong>②.额结节</strong><br><strong>③.眉弓凸起</strong><br><strong>④.眉峰</strong><br><strong>⑤.下眼睑（睑颊沟）</strong><br><br><strong>【交界2 · 鼻—口—颏】</strong><br><strong>⑥.鼻根一侧</strong><br><strong>⑦.鼻底</strong><br><strong>⑧.唇峰</strong><br><strong>⑨.嘴角窝</strong><br>⑩→⑪.下唇一侧圆形凸起，到降下唇肌上的交界<br>⑫→⑬.颏肌上的交界<br><br><strong>【交界3 · 颧→鼻唇沟】（对照）</strong><br>Ⓐ→Ⓑ.颧骨到鼻唇沟附近<br>本模上这条交界很明显（东方人前脸较平）<br><br>可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。<br><br>本场景是同一课的对比个体（女05）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。"},"id":"L04_female_05"}
