,0.1323,0.0591],"localNormal":[0.625,-0.365,0.69],"baseDist":5.6029,"baseScale":5.8,"labelShape":"circle"},{"id":"anno_1789604294767_346","annotationKind":"leader","text":"E","detailText":"","collapsed":false,"color":"#e6e6e6","dx":-53.00001900653424,"dy":44.00001578509415,"dxN":-0.030671,"dyN":0.042885,"dxW":-0.114015,"dyW":0.094654,"localPos":[0.0258,0.1167,0.0215],"localNormal":[0.484,-0.859,0.166],"baseDist":5.7879554068696795,"baseScale":5.8,"labelShape":"circle"}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"view","slot":"V05b","status":"screen_remap_needs_handtune","detail":"侧后（隐鼻）外轮廓的重要点位；请与「见鼻」对照","keyPoints":"本场景的研究对象是侧后（隐鼻）视角的头部外轮廓。请与「见鼻」对照：鼻退隐后，外轮廓主角会换成颧突隆一带。如果您不小心转动了视角，请点击重置按钮恢复视角。\n\n请看场景中的标注，1–5 是轮廓上的凸起，A–E 是外轮廓上的重要凹陷。这些点位决定了侧后（隐鼻）视角下头部的外轮廓形态特征。（耳朵在所有场景都不参与外轮廓的标注）\n\n实际中每个人凹凸强弱不同，创作时先有这些点位的框架，再按个体强化、弱化这些点位的偏移，即可得到不同的人物特征。\n\n各点位名称如下：\n1.额结节\n2.眉弓（眉峰上）\n3.颧突隆\n4.口轮匝肌\n5.颏结节\nA.眉弓上缘\nB.眼裂\nC.颊凹\nD.口轮匝肌下缘／颏唇沟同一水平线上\nE.颈点\n\n本场景是同一课的对比个体（女05）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。","keyPointsRich":"本场景的研究对象是侧后（隐鼻）视角的头部外轮廓。请与「见鼻」对照：鼻退隐后，外轮廓主角会换成颧突隆一带。如果您不小心转动了视角，请点击重置按钮恢复视角。<br><br>请看场景中的标注，1–5 是轮廓上的凸起，A–E 是外轮廓上的重要凹陷。这些点位决定了侧后（隐鼻）视角下头部的外轮廓形态特征。（耳朵在所有场景都不参与外轮廓的标注）<br><br>实际中每个人凹凸强弱不同，创作时先有这些点位的框架，再按个体强化、弱化这些点位的偏移，即可得到不同的人物特征。<br><br>各点位名称如下：<br><strong>1.额结节</strong><br><strong>2.眉弓（眉峰上）</strong><br><strong>3.颧突隆</strong><br><strong>4.口轮匝肌</strong><br><strong>5.颏结节</strong><br><strong>A.眉弓上缘</strong><br><strong>B.眼裂</strong><br><strong>C.颊凹</strong><br><strong>D.口轮匝肌下缘／颏唇沟同一水平线上</strong><br><strong>E.颈点<br></strong><br>本场景是同一课的对比个体（女05）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。"},"id":"V05b_female_05"}
