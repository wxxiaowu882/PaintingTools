:[0,0,0]},{"pos":[-0.0366,0.1456,0.0492],"norm":[-0.824,-0.347,0.448],"handleIn":[0,0,0],"handleOut":[0,0,0]},{"pos":[-0.0165,0.1236,0.0571],"norm":[-0.395,-0.886,0.244],"handleIn":[0,0,0]}],"kind":"bezier","strokeWidth":2,"opacity":0.81,"capR":1},{"id":"dash_line_1789967253060","color":"#d4d4d4","points":[{"pos":[-0.0489,0.2571,0.0343],"norm":[-0.797,0.414,0.44],"handleOut":[-0.0012,-0.0051,0.0005]},{"pos":[-0.0523,0.2311,0.0422],"norm":[-0.842,0.123,0.525],"handleIn":[0.0008,0.0106,-0.0021],"handleOut":[-0.0007,-0.0087,0.0017]},{"pos":[-0.0557,0.2091,0.0404],"norm":[-0.829,0.092,0.552],"handleIn":[0.0012,0.0037,0.0012]}],"kind":"bezier","strokeWidth":2,"opacity":0.81,"capR":1},{"id":"dash_line_1789967530042","color":"#d4d4d4","points":[{"pos":[-0.05,0.0808,-0.016],"norm":[-0.827,0.343,0.446],"handleOut":[0,0,0]},{"pos":[-0.04,0.1273,-0.0004],"norm":[-0.855,-0.221,0.47],"handleIn":[-0.003,-0.0133,-0.0056],"handleOut":[0.0014,0.0047,0.01]},{"pos":[-0.0248,0.1226,0.0213],"norm":[-0.643,-0.687,0.338],"handleIn":[0,0,0]}],"kind":"bezier","strokeWidth":2,"opacity":0.81,"capR":1},{"id":"dash_line_1789967575318","color":"#d4d4d4","points":[{"pos":[-0.0471,0.1467,-0.0131],"norm":[-0.977,-0.212,0.001],"handleOut":[0.0043,-0.0082,0.0048]},{"pos":[-0.041,0.113,-0.0055],"norm":[-0.837,-0.063,0.543],"handleIn":[-0.0012,0.0039,0.0002]}],"kind":"bezier","strokeWidth":2,"opacity":0.96,"capR":1}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"light","slot":"L08","status":"vision_place_pending_qa","detail":"背侧光下明暗交界（内轮廓）关键点位；对照下一场景 B","keyPoints":"本场景的研究对象是背侧光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。\n\n请看场景中的标注，圆标钉在交界经过的关键结构点／线段上。这些点位决定了这一档光下头部的光影交界形态。请与下一场景「背面光 · 背侧交界B」对照：本场景（A）更偏侧后、交界更靠脸侧；下一场景（B）更贴正后背侧亮边。\n\n实际中每个人结构起伏强弱不同，创作时先有这些点位的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。\n\n各点位／交界名称如下：\n①–②.颞线\n②.眉峰\n③.眶外角\n①–②–③：不是本模型实际交界线\n①–③：本模型实际交界线\n\n①–②–③这条交界依赖颞线、眉峰、眶外角一带的前后转折。头型偏扁、东亚常见面型、女性、低龄者，这片往往更平，①–②–③交界常不明显甚至几乎糊掉——不是没有这些点，而是亮暗边不够锋利。点位框架仍用①–②–③，再按个体强弱调整。当前各体弱化为①–③\n\n④.颧突隆\n⑤.颧骨外下侧\n红⑥.咬肌前切迹（角前凹）\n白⑥.咬肌下端\n⑦.颏结节\n\n⑤–白⑥-⑦：\n”颧骨→咬肌下端→颏结节“的交界线，\n但是本场景中的个体因咬肌不突出而不明显。\n⑤–红⑥-⑦：\n“颧骨→咬肌前切迹→颏结节“ 的交界线，\n此交界线在本场景中的个体上较明显。\n\n⑧.胸锁乳突肌上的交界+侧脸到下颌底的交界\n\n【补充】咬肌前切迹：在下颌骨下缘，咬肌附着点前方、颏结节后方，口轮匝肌侧下方；前凸后鼓，所以略凹陷。\n\n可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。\n\n本场景是同一课的对比个体（光头亚裔）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。","keyPointsRich":"本场景的研究对象是背侧光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。<br><br>请看场景中的标注，圆标钉在交界经过的关键结构点／线段上。这些点位决定了这一档光下头部的光影交界形态。请与下一场景「背面光 · 背侧交界B」对照：本场景（A）更偏侧后、交界更靠脸侧；下一场景（B）更贴正后背侧亮边。<br><br>实际中每个人结构起伏强弱不同，创作时先有这些点位的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。<br><br><strong>各点位／交界名称如下：</strong><br><strong>①–②.颞线</strong><br><strong>②.眉峰</strong><br><strong>③.眶外角</strong><br><strong>①–②–③：不是本模型实际交界线</strong><br><strong>①–③：本模型实际交界线</strong><br><br><strong>①–②–③这条交界依赖颞线、眉峰、眶外角一带的前后转折。头型偏扁、东亚常见面型、女性、低龄者，这片往往更平，①–②–③交界常不明显甚至几乎糊掉——不是没有这些点，而是亮暗边不够锋利。点位框架仍用①–②–③，再按个体强弱调整。当前各体弱化为①–③</strong><br><strong><br></strong><strong>④.颧突隆</strong><br><strong>⑤.颧骨外下侧</strong><br><strong>红⑥.咬肌前切迹（角前凹）</strong><br><strong>白⑥.咬肌下端</strong><br><strong>⑦.颏结节</strong><br><strong><br></strong><strong>⑤–白⑥-⑦：</strong><br><strong>”颧骨→咬肌下端→颏结节“的交界线，</strong><br><strong>但是本场景中的个体因咬肌不突出而不明显。<br></strong><strong>⑤–红⑥-⑦：</strong><br><strong>“颧骨→咬肌前切迹→颏结节“ 的交界线，</strong><br><strong>此交界线在本场景中的个体上较明显。</strong><br><br><strong>⑧.胸锁乳突肌上的交界+侧脸到下颌底的交界</strong><br><br><strong>【补充】咬肌前切迹：在下颌骨下缘，咬肌附着点前方、颏结节后方，口轮匝肌侧下方；前凸后鼓，所以略凹陷。</strong><br><br>可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。<br><br>本场景是同一课的对比个体（光头亚裔）。点位框架与参考模（大本）一致，请对照凹凸强弱与宽窄差异。"},"id":"L08_male_bald_asian_01"}