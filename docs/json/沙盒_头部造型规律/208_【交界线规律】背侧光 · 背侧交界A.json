-0.801,0.18]},{"pos":[-0.0212,0.0578,0.0591],"norm":[-0.516,-0.843,0.154]},{"pos":[-0.02,0.0574,0.0604],"norm":[-0.499,-0.848,0.177]}],"kind":"bezier","projected":true,"strokeWidth":2,"capR":1}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"line":"light","slot":"L08","status":"handtuned","detail":"背侧光下明暗交界（内轮廓）关键点位；对照下一场景 B","keyPoints":"本场景的研究对象是背侧光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。\n\n请看场景中的标注，圆标钉在交界经过的关键结构点／线段上。这些点位决定了这一档光下头部的光影交界形态。请与下一场景「背面光 · 背侧交界B」对照：本场景（A）更偏侧后、交界更靠脸侧；下一场景（B）更贴正后背侧亮边。\n\n实际中每个人结构起伏强弱不同，创作时先有这些点位的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。\n\n各点位／交界名称如下：\n①–②.颞线\n②.眉峰\n③.眶外角\n④.颧突隆\n⑤–白⑥-⑦：\n当咬肌发达而更突出，口轮匝肌不发达时的交界线。\n此时白⑥是咬肌下端。本场景中的模型属于这种情况。\n⑤–红⑥-⑦：\n当咬肌不发达，口轮匝肌更发达而突出时的交界线。\n此时红⑥是咬肌前切迹（角前凹），在口轮匝肌侧下方。\n本场景中的模型不属于这种情况。\n\n红⑥.咬肌前切迹（角前凹）\n白⑥.咬肌下端\n⑦.颏结节\n⑧.胸锁乳突肌上的交界+侧脸到下颌底的交界\n\n【补充】咬肌前切迹：在下颌骨下缘，咬肌附着点前方、颏结节后方，口轮匝肌侧下方；前凸后鼓，所以略凹陷。\n\n可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。\n","keyPointsRich":"本场景的研究对象是背侧光下的明暗交界线（也可叫内轮廓）。请不要改当前光线；误改请点「重置」。可以转动场景，换角度看交界。<br><br>请看场景中的标注，圆标钉在交界经过的关键结构点／线段上。这些点位决定了这一档光下头部的光影交界形态。请与下一场景「背面光 · 背侧交界B」对照：本场景（A）更偏侧后、交界更靠脸侧；下一场景（B）更贴正后背侧亮边。<br><br>实际中每个人结构起伏强弱不同，创作时先有这些点位的框架，再按个体强化、弱化，即可得到不同的人物特征与光影。<br><br><strong>各点位／交界名称如下：</strong><br><strong>①–②.颞线</strong><br><strong>②.眉峰</strong><br><strong>③.眶外角</strong><br><strong>④.颧突隆</strong><br><strong>⑤–白⑥-⑦：</strong><br><strong>当咬肌发达而更突出，口轮匝肌不发达时的交界线。</strong><br><strong>此时白⑥是咬肌下端。</strong><br><strong>本场景中的模型属于这种情况。<br></strong><strong>⑤–红⑥-⑦：</strong><br><strong>当咬肌不发达，口轮匝肌更发达而突出时的交界线。</strong><br><strong>此时红⑥是咬肌前切迹（角前凹），在口轮匝肌侧下方。</strong><br><strong>本场景中的模型不属于这种情况。<br></strong><strong><br></strong><br><strong>红⑥.咬肌前切迹（角前凹）</strong><br><strong>白⑥.咬肌下端</strong><br><strong>⑦.颏结节</strong><br><strong>⑧.胸锁乳突肌上的交界+侧脸到下颌底的交界<br></strong><br><strong>【补充】咬肌前切迹：在下颌骨下缘，咬肌附着点前方、颏结节后方，口轮匝肌侧下方；前凸后鼓，所以略凹陷。</strong><br><br>可点击操作面板上的眼睛图标隐藏标注，更干净地观察明暗交界线。"},"id":"L08"}
