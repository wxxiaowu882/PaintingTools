,4.836],"rot":[1.128,0.878,-1.804],"scale":[1.055,1.055,1.055],"color":"#3ed507"},{"type":"builtin","shape":"sphere","pos":[-5.473,1.564,-2.052],"rot":[0,0,0],"scale":[0.782,0.782,0.782],"color":"#fa0000"},{"type":"builtin","shape":"sphere","pos":[-1.176,1.023,8.486],"rot":[0,0,0],"scale":[0.511,0.511,0.511],"color":"#fa0000"},{"type":"builtin","shape":"sphere","pos":[5.992,1.51,7.51],"rot":[0,0,0],"scale":[0.755,0.755,0.755],"color":"#ff0000"},{"type":"builtin","shape":"tetrahedron","pos":[2.879,0.766,8.764],"rot":[0.895,-0.738,-0.087],"scale":[1.055,1.055,1.055],"color":"#64b148"},{"type":"builtin","shape":"tetrahedron","pos":[9.337,0.502,4.836],"rot":[0.626,-0.173,-0.661],"scale":[0.849,0.849,0.849],"color":"#36c403"},{"type":"builtin","shape":"tetrahedron","pos":[10.561,1.056,-5.35],"rot":[0.64,0.256,-0.972],"scale":[1.634,1.634,1.634],"color":"#32bd00"},{"type":"builtin","shape":"tetrahedron","pos":[5.756,2.026,-5.35],"rot":[0.64,0.256,-0.972],"scale":[2.69,2.69,2.69],"color":"#32bd00","annotations":[{"id":"anno_1785829907062_33","annotationKind":"leader","text":"差异 · 绿锥","detailText":"","collapsed":false,"color":"#bdb9b2","dx":53.11419132737764,"dy":-37.179945507139216,"dxN":0.032407,"dyN":-0.037874,"dxW":2.294689,"dyW":-1.606283,"localPos":[-0.5863,0.9791,-0.4107],"localNormal":[-0.577,0.577,0.577],"baseDist":37.89554935725161,"baseScale":2.69}]},{"type":"builtin","shape":"sphere","pos":[10.582,0.735,4.538],"rot":[0,0,0],"scale":[-0.373,-0.373,-0.373],"color":"#f90606"}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"detail":"<b>和谐共处</b>\n\n截然不同的个体，你中有我，我中有你，和谐共处。","category":"构图","keyPoints":"【构图】例7 · 和谐共处。\n\n例6用楼群做对比与节奏。这一例换题：差异很大的两类形体，如何不打架、反而相融。\n\n① 先立意  \n立意「和谐共处」：造型、色彩截然不同的两类形体相互穿插——你中有我、我中有你，表达差异之物彼此相融、共生共存。\n\n② 达共识  \n全部几何体共处同一空间，共用统一光源与空间规则。\n\n③ 造冲突  \n请就眼前这个画面看两类形体：圆球曲线柔和，三角锥棱角锐利；红与绿又是互补色对比。形态与色调双重差异，冲突很鲜明。\n\n④ 驯冲突  \n以中心大红球为主体，其余为宾，主次分明、以宾衬主；两类形体交错渗透、疏密错落，生出节奏与律动；迥异形体彼此穿插呼应，消解硬对立，让矛盾元素相融共生，整体平衡。\n\n请牢记：和谐不是抹平差异，是让差异穿插共生。冲突造得够，驯得住，才叫共处。\n\n下一例换题：阁楼上的奖杯——形态各异的一堆形体，如何编排成秩序。","keyPointsRich":"【构图】例7 · <strong style=\"color: rgb(255, 217, 102);\">和谐共处</strong>。<br><br>例6用楼群做对比与节奏。这一例换题：<strong style=\"color: rgb(255, 217, 102);\">差异很大的两类形体，如何不打架、反而相融。</strong><br><br><strong style=\"color: rgb(255, 217, 102);\">① 先立意  </strong><br>立意「和谐共处」：造型、色彩截然不同的两类形体相互穿插——你中有我、我中有你，表达差异之物彼此相融、共生共存。<br><br><strong style=\"color: rgb(255, 217, 102);\">② 达共识  </strong><br>全部几何体共处同一空间，共用统一光源与空间规则。<br><br><strong style=\"color: rgb(255, 217, 102);\">③ 造冲突  </strong><br>请就眼前这个画面看两类形体：圆球曲线柔和，三角锥棱角锐利；红与绿又是互补色对比。<strong style=\"color: rgb(255, 217, 102);\">形态与色调双重差异</strong>，冲突很鲜明。<br><br><strong style=\"color: rgb(255, 217, 102);\">④ 驯冲突  </strong><br>以中心大红球为主体，其余为宾，<strong style=\"color: rgb(255, 217, 102);\">主次</strong>分明、以宾衬主；两类形体交错渗透、疏密错落，生出节奏与律动；迥异形体彼此<strong style=\"color: rgb(255, 217, 102);\">穿插</strong>呼应，消解硬对立，让矛盾元素<strong style=\"color: rgb(255, 217, 102);\">相融共生</strong>，整体<strong style=\"color: rgb(255, 217, 102);\">平衡</strong>。<br><br>请牢记：<strong style=\"color: rgb(255, 217, 102);\">和谐不是抹平差异，是让差异穿插共生。冲突造得够，驯得住，才叫共处。</strong><br><br>下一例换题：阁楼上的奖杯——形态各异的一堆形体，如何编排成秩序。"},"uid":"1061"}