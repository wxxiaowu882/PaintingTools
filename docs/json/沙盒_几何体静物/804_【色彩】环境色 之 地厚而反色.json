dy":68.76174228255572,"dxN":0.002315,"dyN":0.066947,"dxW":0.094363,"dyW":1.634641,"localPos":[1.299,-0.3897,0.0137],"localNormal":[1,0,0],"baseDist":21.831322903301757,"baseScale":0.8341996343439732,"ringWorldRadius":0.045,"lineColor":"#ffffff","labelText":"受地面色影响","detailText":"","labelVisible":true}]},{"type":"builtin","shape":"cube","pos":[-4.122,0.795,-4.669],"rot":[0,0,0],"scale":[0.53,0.53,0.53],"color":"#e8e587","colorSampleAnnotations":[{"id":"csanno_1783409017749_9","annotationKind":"colorSample","dx":48.3159038437316,"dy":7.020780763813821,"dxN":0.027961,"dyN":0.006783,"dxW":1.243074,"dyW":0.180631,"localPos":[1.5,-0.3913,-0.3091],"localNormal":[1,0,0],"baseDist":23.53344956043803,"baseScale":0.53,"ringWorldRadius":0.045,"lineColor":"#ffffff","labelText":"受地面色影响","detailText":"","labelVisible":true}]}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[{"id":"csanno_1783409046991_13","annotationKind":"colorSample","dx":77.3257408814239,"dy":28.885093585651713,"dxN":0.044749,"dyN":0.027908,"dxW":1.479108,"dyW":0.552522,"localPos":[-2.551,-3.3675,0],"localNormal":[0,0,1],"baseDist":17.81975313526727,"baseScale":1,"ringWorldRadius":0.045,"lineColor":"#ffffff","labelText":"地面色","detailText":"","labelVisible":true}],"meta":{"detail":"<b>地厚而返色</b>\n\n暗部更容易被地面染色。","category":"色彩","keyPoints":"【色彩】环境色 · 地厚而返色。\n\n上一关看的是天光怎么染阴。这一关看地面怎么把颜色反回来——这就叫「地厚而返色」。\n\n请就眼前这个画面，对照各物体上的色样看：地面是暖褐色，所以靠近地面的暗部，都会多少带上一点地面的暖色味。\n\n你可以调节”氛围>地面“来改变地面的颜色，观察物体暗部的偏色变化。\n\n这里要先记住一件事：不只是暗部，亮部其实也会接到地面的反光色；只是亮部正被主光照着，地面那点微弱返色容易被压住，不明显。暗部因为吃不到主光，对这点返色更敏感，所以我们更容易在暗部里看见它。\n\n那么以下规律也是容易理解的：离地越近，返色越明显；离地越高，返色越弱。也就是说，同一个物体上，靠近地面的部分，更容易被地面染到（地面色会混合到物体固有色中）。\n\n请牢记：地面不只托住物体，也会把自己的颜色反射到物体上。\n\n下一站「物邻而色交」：不只是地面，旁边的物体也会把颜色反到彼此身上。","keyPointsRich":"【色彩】环境色 · 地厚而返色。<br><br>上一关看的是天光怎么染阴。这一关看地面怎么把颜色反回来——这就叫「地厚而返色」。<br><br>请就眼前这个画面，对照各物体上的色样看：地面是暖褐色，所以靠近地面的暗部，都会多少带上一点地面的暖色味。<br><br>你可以调节”氛围&gt;地面“来改变地面的颜色，观察物体暗部的偏色变化。<br><br>这里要先记住一件事：<strong style=\"color: rgb(255, 217, 102);\">不只是暗部，亮部其实也会接到地面的反光色；只是亮部正被主光照着，地面那点微弱返色容易被压住，不明显。暗部因为吃不到主光，对这点返色更敏感，所以我们更容易在暗部里看见它。</strong><br><br>那么以下规律也是容易理解的：<strong style=\"color: rgb(255, 217, 102);\">离地越近，返色越明显；离地越高，返色越弱</strong>。也就是说，同一个物体上，靠近地面的部分，更容易被地面染到（地面色会混合到物体固有色中）。<br><br>请牢记：<strong style=\"color: rgb(255, 217, 102);\">地面不只托住物体，也会把自己的颜色反射到物体上。</strong><br><br>下一站「物邻而色交」：不只是地面，旁边的物体也会把颜色反到彼此身上。"}}