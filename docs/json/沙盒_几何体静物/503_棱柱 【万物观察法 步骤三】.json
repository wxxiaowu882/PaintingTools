":-0.029952,"dxW":-2.604001,"dyW":-0.422197,"localPos":[-0.3769,2,0.1977],"localNormal":[0,1,0],"baseDist":12.47522538284127,"baseScale":1},{"id":"anno_1783307700136_44","annotationKind":"leader","text":"暗灰 + 反光\n（开启渲染后反光更明显）","detailText":"","collapsed":false,"color":"#ededed","dx":270.73190326956393,"dy":-73.79521875667429,"dxN":0.139699,"dyN":-0.063575,"dxW":3.468216,"dyW":-0.945355,"localPos":[0.7312,-1.4323,1.0779],"localNormal":[0.5,0,0.866],"baseDist":12.647682897169485,"baseScale":1}]}],"groundAnnotations":[{"id":"anno_1783303293677_34","annotationKind":"leader","text":"投影","detailText":"","collapsed":false,"color":"#ededed","dx":104.26660701335523,"dy":95.354920753042,"dxN":0.054167,"dyN":0.082705,"dxW":1.535436,"dyW":1.404202,"localPos":[1.9376,1.3812,0],"localNormal":[0,0,1],"baseDist":14.628349718338315,"baseScale":1}],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"detail":"<b>三生万物，层次分化</b>\n\n阴阳融合、分化，形成介于阴阳之间的各种层次。","category":"几何体","keyPoints":"万物观察法 · 棱柱 · 第三步：三生万物，层次分化。\n\n交界立住之后，亮与暗还会继续融合、分化，长出介于中间的各种层次。\n\n请你对照棱柱上的标注看清这一层：\n\n亮部里分出：高光、亮灰。\n高光：光滑时更抢眼，哑光时往往很弱；多面体上，高光常落在最向光的那一面（或棱边附近）。\n亮灰：亮部里去掉高光之后，剩下的亮面。\n\n暗部里分出：暗灰、反光、投影。\n暗灰是背光面；因为还会接到环境反光，所以很少会死黑。\n反光常藏在暗灰里——开启渲染后通常更明显。\n投影在地面上，和柱体暗面是两回事，这一步先都归在暗的层次里认清。\n\n明暗交界线：亮面与暗面在棱上相遇处。棱柱面多，交界也可能不止一条——这和上一步「①②③里主观立交界」是同一件事的继续。\n\n请牢记：一生二 → 二生三 → 三生万物——先分阴阳，再立交界，再让层次长出来。\n\n下一站盯「最暗处」：受光最少，即最暗。","keyPointsRich":"万物观察法 · 棱柱 · 第三步：<strong style=\"color: rgb(255, 217, 102);\">三生万物，层次分化。</strong><br><br>交界立住之后，亮与暗还会继续融合、分化，长出介于中间的各种层次。<br><br>请你对照棱柱上的标注看清这一层：<br><br><strong style=\"color: rgb(255, 217, 102);\">亮部里分出：高光、亮灰</strong>。<br>高光：光滑时更抢眼，哑光时往往很弱；多面体上，高光常落在最向光的那一面（或棱边附近）。<br>亮灰：亮部里去掉高光之后，剩下的亮面。<br><br><strong style=\"color: rgb(255, 217, 102);\">暗部里分出：暗灰、反光、投影。</strong><br>暗灰是背光面；因为还会接到环境反光，所以很少会死黑。<br>反光常藏在暗灰里——开启渲染后通常更明显。<br>投影在地面上，和柱体暗面是两回事，这一步先都归在暗的层次里认清。<br><br>明暗交界线：亮面与暗面在棱上相遇处。棱柱面多，交界也可能不止一条——这和上一步「①②③里主观立交界」是同一件事的继续。<br><br>请牢记：<strong style=\"color: rgb(255, 217, 102);\">一生二 → 二生三 → 三生万物——先分阴阳，再立交界，再让层次长出来。</strong><br><br>下一站盯「最暗处」：受光最少，即最暗。"}}