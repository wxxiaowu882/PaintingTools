0.596,0,0.803],"baseDist":23.883540109417886,"baseScale":1}]},{"type":"builtin","shape":"sphere","pos":[3.665,0.626,3.421],"rot":[0,0,0],"scale":[0.313,0.313,0.313],"color":"#c2c2c2"}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[],"meta":{"detail":"<b>聚光氛围</b>\n\n主光是聚光灯——光沿锥形射出，全场呈追光式的光气氛。","category":"氛围","keyPoints":"【氛围·光】聚光。\n\n前面看过冷暖与强弱。这一关换「光怎么射出来」：主光是聚光灯，光沿锥形射出。\n\n请就眼前这个画面看：像舞台追光只打在中央——光柱里亮，光柱外迅速暗下去，视线被收进一束光里。有明确光区：区内亮、区外暗。各物仍同处这一锥光，明暗主要随「在不在光柱里」而变，不是每个物体自带一盏灯。\n\n什么时候用聚光？常见是想让画面有焦点、被注视感的时候——如舞台追光、展柜重点、神圣或仪式感、夜间一束灯照住主体。要表现「看这里」、戏剧中心、被挑选出来的存在感，聚光往往比漫开的光更贴。\n\n请牢记：聚光氛围 = 同一锥光划出明区与暗区。先认「在不在光柱里」，再问「我要不要把视线收成一束」。\n\n下一站对照：点光——从一点向四周散开，像一支蜡烛。","keyPointsRich":"【氛围·光】<strong style=\"color: rgb(255, 217, 102);\">聚光</strong>。<br><br>前面看过冷暖与强弱。这一关换「光怎么射出来」：主光是聚光灯，光沿锥形射出。<br><br>请就眼前这个画面看：像舞台追光只打在中央——光柱里亮，光柱外迅速暗下去，视线被收进一束光里。有明确光区：区内亮、区外暗。各物仍同处这一锥光，明暗主要随「在不在光柱里」而变，不是每个物体自带一盏灯。<br><br>什么时候用聚光？常见是<strong style=\"color: rgb(255, 217, 102);\">想让画面有焦点、被注视感的时候——如舞台追光、展柜重点、神圣或仪式感、夜间一束灯照住主体。要表现「看这里」、戏剧中心、被挑选出来的存在感，聚光往往比漫开的光更贴。</strong><br><br>请牢记：聚光氛围 = 同一锥光划出明区与暗区。先认「在不在光柱里」，再问「我要不要把视线收成一束」。<br><br>下一站对照：点光——从一点向四周散开，像一支蜡烛。"},"uid":"916"}