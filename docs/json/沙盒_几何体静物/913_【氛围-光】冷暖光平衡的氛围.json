,0],"scale":[0.546,0.546,0.546],"color":"#cc2486","colorSampleAnnotations":[{"id":"csanno_1783520143192_11","annotationKind":"colorSample","dx":-48.42664778037631,"dy":-7.8042643889137375,"dxN":-0.028009,"dyN":-0.007536,"dxW":-1.110685,"dyW":-0.178994,"localPos":[-1.6649,0.9742,0.5235],"localNormal":[-0.819,0.492,0.293],"baseDist":20.302857064077507,"baseScale":0.546,"ringWorldRadius":0.045,"lineColor":"#c2c2c2","labelText":"暖红","detailText":"","labelVisible":true},{"id":"csanno_1783520159670_13","annotationKind":"colorSample","dx":63.307208905645226,"dy":23.439690308572466,"dxN":0.036574,"dyN":0.022609,"dxW":1.45595,"dyW":0.53907,"localPos":[0.9412,1.7023,0.4604],"localNormal":[0.484,0.845,0.229],"baseDist":20.440551436085528,"baseScale":0.546,"ringWorldRadius":0.045,"lineColor":"#c2c2c2","labelText":"冷红","detailText":"","labelVisible":true}]},{"type":"builtin","shape":"cylinder","pos":[0.278,2,0],"rot":[0,0,0],"scale":[1,1,1],"color":"#c2c2c2"},{"type":"builtin","shape":"sphere","pos":[3.665,0.626,3.421],"rot":[0,0,0],"scale":[0.313,0.313,0.313],"color":"#c2c2c2"}],"groundAnnotations":[],"groundNormArrows":[],"groundPolygon3ds":[],"groundColorSampleAnnotations":[{"id":"csanno_1783519905967_9","annotationKind":"colorSample","dx":59.76051259567158,"dy":61.55331478235488,"dxN":0.034722,"dyN":0.05971,"dxW":1.495011,"dyW":1.539861,"localPos":[-6.4973,-4.2673,0],"localNormal":[0,0,1],"baseDist":22.694638302612145,"baseScale":1,"ringWorldRadius":0.045,"lineColor":"#c2c2c2","labelText":"暖\n中性地面的亮部被主光照暖","detailText":"","labelVisible":true},{"id":"csanno_1783519920112_10","annotationKind":"colorSample","dx":-51.776039255563674,"dy":-102.51281177549956,"dxN":-0.029963,"dyN":-0.099045,"dxW":-2.991329,"dyW":-5.922615,"localPos":[17.0439,25.3728,0],"localNormal":[0,0,1],"baseDist":54.36682419777583,"baseScale":1,"ringWorldRadius":0.045,"lineColor":"#c2c2c2","labelText":"冷\n中性地面的暗部被天光照冷","detailText":"","labelVisible":true}],"meta":{"detail":"<b>光调归一 · 冷暖平衡</b>\n\n主光 + 环境光 → 全场景共享一套冷暖平衡的光氛围。","category":"氛围","keyPoints":"【氛围·光】冷暖光平衡氛围。\n\n暖光、冷光各走了一关。这一关看更常见的一种：同一套光里，冷暖同时在场，但彼此压得住——不是整幅一味暖，也不是一味冷。\n\n请就眼前这个画面，对照色样看：主光偏暖，天光偏冷，地面固有色偏中性。于是又因为主光强度占优，所有物体亮部更容易偏暖，暗部更容易偏冷；粉球上也是暖红与冷红并置。全场仍是「同光归一」，只是这套光内部有冷暖分工。\n\n什么时候用冷暖平衡？\n常见是想让画面自然、可信、耐看的时候——如日常日光写生、室外建筑与石膏、人物与静物的「正常光照感」。它不像纯暖那样煽情，也不像纯冷那样疏离；信息清楚，情绪稳，适合作为观察与表达的底色。\n\n请牢记：冷暖平衡 = 同一套光里冷暖共置。先认亮暖暗冷（或主光暖、天光冷），再问「我要的是自然常态，还是刻意偏暖/偏冷」。\n\n下一站换强度：强光——对比拉高时，氛围会怎样变硬、变有力。","keyPointsRich":"【氛围·光】冷暖光平衡氛围。<br><br>暖光、冷光各走了一关。这一关看<strong style=\"color: rgb(255, 217, 102);\">更常见的一种：同一套光里，冷暖同时在场，但彼此压得住——不是整幅一味暖，也不是一味冷。</strong><br><br>请就眼前这个画面，对照色样看：<strong style=\"color: rgb(255, 217, 102);\">主光偏暖，天光偏冷，地面固有色偏中性。于是又因为主光强度占优，所有物体亮部更容易偏暖，暗部更容易偏冷；粉球上也是暖红与冷红并置。全场仍是「同光归一」，只是这套光内部有冷暖分工。</strong><br><br>什么时候用冷暖平衡？<br><strong style=\"color: rgb(255, 217, 102);\">常见是想让画面自然、可信、耐看的时候——如日常日光写生、室外建筑与石膏、人物与静物的「正常光照感」。它不像纯暖那样煽情，也不像纯冷那样疏离；信息清楚，情绪稳，适合作为观察与表达的底色。</strong><br><br>请牢记：冷暖平衡 = 同一套光里冷暖共置。先认亮暖暗冷（或主光暖、天光冷），再问「我要的是自然常态，还是刻意偏暖/偏冷」。<br><br>下一站换强度：强光——对比拉高时，氛围会怎样变硬、变有力。"}}