# Workers 静态资源忽略（语法同 gitignore）
# soft-voice-f822 = Worker 仅静态资源；单文件上限 25 MiB

.git/
.wrangler/
node_modules/
dist/
functions/
Cloudflare/
.cursor/
历史备份文件/
历史部署压缩包/
临时_METS二级备考/

# 自用工具整树不上传（避免超大 blend/glb；线上会员发版不依赖这些）
自用工具文件_不部署/

# 超大二进制（Workers 上限 25 MiB；需单独压缩后再放行）
# 加密后同名 .png 体积几乎不变，须与 .glb 一并忽略，否则发版会卡 25MiB
docs/m/石膏头像_男中青年_布鲁特斯_Bargello扫_opt.glb
docs/m/石膏头像_男中青年_布鲁特斯_Bargello扫_opt.png
*.blend
*.blend1
*.blend2
*.psd
*.zip
*.7z
*.rar
*.glb.bak

# 构建/配置勿公开
wrangler.toml
.assetsignore
.gitignore
package.json
package-lock.json
docs/last-deploy.log
docs/last-deploy-staging.log
docs/membership/.policy_live_prod_tmp.json
docs/membership/.tiers_live_prod_tmp.json
docs/_test_run_portal20.bat

# 发版/运维脚本勿进站点（含 KV id、流程说明）
docs/deploy.bat
docs/deploy-staging.bat
docs/membership/sync-policy-staging-to-prod.mjs
docs/membership/prod-deploy-preflight.mjs
docs/membership/prod-deploy-smoke.mjs
docs/membership/gen-redeem-code.mjs
docs/membership/sync-model-assetsignore.mjs
docs/membership/backup-membership-kv.mjs
docs/membership/DEPLOY.md
docs/membership/README.md
docs/site-version-bump.mjs

