<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shell_bg">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <!-- 冷启动开场：深色底 + 色立体轻入；文案对齐首页细白字主次 -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/shell_bg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <!-- 视觉锚点：略小于旧版，让「手绘工坊」成为主信息 -->
            <ImageView
                android:id="@+id/splash_mark"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:alpha="0"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:scaleX="0.92"
                android:scaleY="0.92"
                android:src="@drawable/ic_splash_mark" />

            <TextView
                android:id="@+id/splash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:alpha="0"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:letterSpacing="0.22"
                android:text="@string/app_name"
                android:textColor="@color/splash_title"
                android:textSize="26sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/splash_credit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:alpha="0"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:letterSpacing="0.18"
                android:text="@string/splash_credit"
                android:textColor="@color/splash_credit"
                android:textSize="12sp"
                android:textStyle="normal" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
